<Page x:Class="MathPracticePlatform.Views.ResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MathPracticePlatform.Views"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ResultsPage">
    <Page.Background>
        <ImageBrush ImageSource="/Resources/Images/results2.jpg" />
    </Page.Background>

    <Viewbox>
        <Grid Width="600" Height="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="content" Grid.Row="1" Grid.Column="1" Background="{StaticResource grdBackTransBlack}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Scrollable TextBlock -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0" Margin="20">
                    <StackPanel>
                        <TextBlock Text="{Binding Title, FallbackValue='Binding failed'}" Style="{StaticResource txtTitle}" />
                        <TextBlock Text="{Binding EindScore, FallbackValue='Binding failed'}" Style="{StaticResource txtStandaard}" />
                        <TextBlock Text="{Binding Fout}" Style="{StaticResource txtTitle}" />
                        <Image gif:ImageBehavior.AnimatedSource="{Binding GifSource}" Height="30" Width="30"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="100">
                            <TextBlock Text="{Binding FoutenLijst, FallbackValue='Binding failed'}" 
                                       Style="{StaticResource txtStandaard}" 
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                        
                    </StackPanel>
                </ScrollViewer>

                <!-- Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button x:Name="btnBack" Content="Hoofdmenu" HorizontalAlignment="Center" Margin="5" Command="{Binding ButtonBackCommand}" />
                    <Button x:Name="btnRestart" Content="Nog eens" HorizontalAlignment="Center" Margin="5" Command="{Binding ButtonRestartCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
    
</Page>
